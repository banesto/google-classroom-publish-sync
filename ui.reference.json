{
  "ui": {
    "account": "a[href^=\"https://accounts.google.com/SignOutOptions\"], [aria-label*=\"Google Account\"], [data-tooltip*=\"Google Account\"]",
    "open_composer": {
      "text_regex": "^(?:Share something with your class|Announce something to your class|New announcement|Jauns paziņojums)(?:…|\\.{3})?$"
    },
    "composer": "[role=\"dialog\"]:has([contenteditable=\"true\"]), form:has([contenteditable=\"true\"])",
    "editor": "[contenteditable=\"true\"][role=\"textbox\"]",
    "add": {
      "role": "button",
      "name": "Add"
    },
    "drive": {
      "role": "menuitem",
      "name": "Google Drive"
    },
    "post": {
      "role": "button",
      "names": [
        "Post",
        "Izlikt"
      ]
    },
    "picker_frame": "iframe[src*=\"docs.google.com/picker\"], iframe[src*=\"drive.google.com/picker\"]",
    "picker_my_drive": {
      "role": "tab",
      "names": [
        "My Drive",
        "Mans disks"
      ]
    },
    "picker_rows": "[role=\"row\"]",
    "picker_breadcrumbs": "[aria-label=\"Breadcrumb\"] button, [aria-label=\"Breadcrumb\"] [role=\"button\"]",
    "picker_file_id_attribute": "data-id",
    "picker_select": {
      "role": "button",
      "name": "Insert"
    },
    "attachments": "a[href*=\"drive.google.com/file/d/\"], a[href*=\"drive.google.com/open?\"]",
    "posts": "[data-stream-item-id]",
    "post_id_attribute": "data-stream-item-id",
    "post_link": "a[href*=\"/p/\"]",
    "drive_direct": {
      "role": "button",
      "name": "Pievienot Google diska failu"
    }
  }
}
